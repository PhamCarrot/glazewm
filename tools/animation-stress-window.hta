<!doctype html>
<html>
<head>
  <title>GlazeWM Animation Stress Window</title>
  <hta:application
    applicationname="GlazeWMAnimationStress"
    border="thin"
    caption="yes"
    maximizebutton="yes"
    minimizebutton="yes"
    scroll="no"
    singleinstance="no"
    sysmenu="yes"
  />
  <style>
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: #181825;
      color: #cdd6f4;
      font: 20px "Segoe UI", sans-serif;
    }
    body {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    div {
      padding: 24px;
      border: 3px solid #89b4fa;
      border-radius: 12px;
      background: #313244;
      text-align: center;
    }
  </style>
</head>
<body>
  <div>Disposable GlazeWM animation stress window</div>
</body>
</html>
